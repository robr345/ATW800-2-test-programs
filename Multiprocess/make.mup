CFLAGS=/T5 

rm *.btl
rm *.tco
rm *.lku
rm *.cfb
rm *.plc

echo "Compile files..."
icc $CFLAGS system
icc $CFLAGS master
icc $CFLAGS worker

echo "Linking files..."
ilink system.tco master.tco worker.tco $CFLAGS /f    

echo "Running Collect..."
icollect  system.lku /t /o multi.btl /p multi.plc

ls -l *.btl

